SYSTEM = SrVO3
NCORE = 1
KPAR = 4
LMAXMIX=6
EDIFF = 1.E-10
# make sure that the wavefunction is properly converged
NELMIN = 30

# Pin NBANDS so the fixture is reproducible independent of the MPI rank count.
# VASP rounds the default NBANDS up to a multiple of the band-group size, so at
# 4 ranks it picks 23, the topmost eg pair drops out of the [Group 1] EWINDOW
# and n_orbitals changes, which breaks test_converter_svo_bands.py.
NBANDS = 24

# DOS energy window
NEDOS = 3001

# Smearing procedure
ISMEAR = -5

# the energy window to optimize projector channels
EMIN = -1.0
EMAX = 10.1

# use the PAW channel optimization
LORBIT=14

# project to V d
LOCPROJ = 2 : d : Pr

# use exact diag for kpoints_opt
KPOINTS_OPT_MODE = 2

